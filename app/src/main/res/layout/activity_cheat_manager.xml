<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08090C"
    android:padding="16dp">

    <!-- 1. CABEÇALHO DO JOGO -->
    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Castlevania: Belmont's Curse"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvGameMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="0100BA4026E94000 • 1 pacote(s)"
        android:textColor="#6272A4"
        android:textSize="13sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tvGameTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2. BOTÕES DE SUPORTE (LINHA DUPLA REFEITA SEM EMOJIS) -->
    <LinearLayout
        android:id="@+id/llSupportButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/tvGameMeta">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHowToVersion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Como Ver Versão"
            android:textColor="#FFFFFF"
            app:strokeColor="#1F2637"
            app:backgroundTint="#121620"
            app:icon="@drawable/ic_help_outline"
            app:iconTint="#00D4FF"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetectRom"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="Detectar via ROM"
            android:textColor="#FFFFFF"
            app:strokeColor="#1F2637"
            app:backgroundTint="#121620"
            app:icon="@drawable/ic_folder_open"
            app:iconTint="#00D4FF"/>
    </LinearLayout>

    <!-- 3. CONSOLE DE STATUS DA BUILD DETECTADA (ESTILO TERMINAL) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvBuildStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="#121620"
        app:strokeColor="#00FFA3"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/llSupportButtons">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvBuildStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="// BUILD ID ATIVO MATCH"
                android:textColor="#00FFA3"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvBuildHex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="0F1169AA7D0FA452"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. CONTROLE GLOBAL DE SELEÇÃO -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="// MODS DISPONÍVEIS NA VERSÃO ATIVA"
        android:textColor="#6272A4"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cvBuildStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llGlobalSelection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Marcar Todos"
            android:textColor="#00D4FF"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvDeselectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Desmarcar"
            android:textColor="#FF3B30"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- 5. LISTA DE CHEATS COMPACTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCheatsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toTopOf="@id/btnInstallCheats"
        tools:listitem="@layout/item_cheat_layout" />

    <!-- 6. BOTÃO DE INSTALAÇÃO NO EDEN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInstallCheats"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="INSTALAR MODS SELECIONADOS NO EDEN"
        android:textColor="#08090C"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:backgroundTint="#00D4FF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
