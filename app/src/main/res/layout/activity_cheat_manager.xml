<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sf_bg"
    android:padding="16dp">

    <!-- 1. CABEÇALHO DO JOGO -->
    <TextView
        android:id="@+id/tvGameTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="Castlevania: Belmont's Curse"
        android:textColor="@color/sf_text"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/tvGameMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        tools:text="0100BA4026E94000 • 1"
        android:textColor="@color/sf_id"
        android:textSize="13sp"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tvGameTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 2. BOTÕES DE SUPORTE (LINHA DUPLA REFEITA SEM EMOJIS) -->
    <LinearLayout
        android:id="@+id/llSupportButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:weightSum="2"
        app:layout_constraintTop_toBottomOf="@id/tvGameMeta">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHowToVersion"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/detail_btn_how_to_version"
            android:textColor="@color/sf_text"
            app:strokeColor="@color/sf_border"
            app:backgroundTint="@color/sf_card"
            app:icon="@drawable/ic_help_outline"
            app:iconTint="@color/sf_accent"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDetectRom"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/detail_btn_detect_rom"
            android:textColor="@color/sf_text"
            app:strokeColor="@color/sf_border"
            app:backgroundTint="@color/sf_card"
            app:icon="@drawable/ic_folder_open"
            app:iconTint="@color/sf_accent"/>
    </LinearLayout>

    <!-- 3. CONSOLE DE STATUS DA BUILD DETECTADA (ESTILO TERMINAL) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvBuildStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/sf_card"
        app:strokeColor="@color/sf_good"
        app:strokeWidth="1dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintTop_toBottomOf="@id/llSupportButtons">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/tvBuildStatusHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="// BUILD ID"
                android:textColor="@color/sf_good"
                android:textSize="11sp"
                android:textStyle="bold"
                android:fontFamily="monospace" />

            <TextView
                android:id="@+id/tvBuildHex"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                tools:text="0F1169AA7D0FA452"
                android:textColor="@color/sf_text"
                android:textSize="15sp"
                android:fontFamily="monospace" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- 4. CONTROLE GLOBAL DE SELEÇÃO -->
    <TextView
        android:id="@+id/tvSectionTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/detail_section_mods_initial"
        android:textColor="@color/sf_id"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/cvBuildStatus"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/llGlobalSelection"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvSelectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_select_all"
            android:textColor="@color/sf_accent"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"
            android:layout_marginEnd="8dp"/>

        <TextView
            android:id="@+id/tvDeselectAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/detail_deselect_all"
            android:textColor="@color/sf_danger"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:padding="4dp"/>
    </LinearLayout>

    <!-- 5. LISTA DE CHEATS COMPACTA -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCheatsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
        app:layout_constraintBottom_toTopOf="@id/btnInstallCheats"
        tools:listitem="@layout/item_cheat_layout" />

    <!-- 6. BOTÃO DE INSTALAÇÃO NO EDEN -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnInstallCheats"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/detail_install_button_xml"
        android:textColor="@color/sf_on_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="8dp"
        app:backgroundTint="@color/sf_accent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
