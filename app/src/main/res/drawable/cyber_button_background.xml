<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- Fundo do botão integrado ao tema escuro -->
    <solid android:color="@color/sf_card" />
    
    <!-- Linha de contorno muito fina de estilo tecnológico -->
    <stroke
        android:width="1dp"
        android:color="@color/sf_border" />
    
    <!-- Arredondamento sutil dos cantos -->
    <corners android:radius="12dp" />
</shape>
