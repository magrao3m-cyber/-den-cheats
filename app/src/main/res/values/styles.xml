<resources>
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">#08090C</item>
        <item name="colorPrimary">#00D4FF</item>
        <item name="colorPrimaryDark">#08090C</item>
        <item name="colorAccent">#00D4FF</item>
        <item name="android:statusBarColor">#08090C</item>
        <item name="android:navigationBarColor">#08090C</item>
        <item name="android:colorControlActivated">#00D4FF</item>
        <item name="android:colorControlHighlight">#1A2234</item>
        <item name="android:alertDialogTheme">@style/AppAlertDialog</item>
    </style>

    <!-- Diálogos escuros, arredondados e com animação suave de entrada/saída. -->
    <style name="AppAlertDialog" parent="android:Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:windowAnimationStyle">@style/AppDialogAnimation</item>
        <item name="android:textColorPrimary">#F0F6FC</item>
        <item name="android:textColorSecondary">#B6C0CC</item>
        <item name="android:textColorHint">#8B949E</item>
        <item name="android:colorAccent">#00D4FF</item>
        <item name="android:colorControlActivated">#00D4FF</item>
        <item name="android:colorControlHighlight">#1A2234</item>
    </style>

    <style name="AppDialogAnimation" parent="android:Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/dialog_enter</item>
        <item name="android:windowExitAnimation">@anim/dialog_exit</item>
    </style>
</resources>
